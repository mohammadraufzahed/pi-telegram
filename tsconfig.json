{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "skipLibCheck": true
  },
  "include": [
    "extensions/**/*.ts",
    "tests/**/*.ts"
  ]
}
